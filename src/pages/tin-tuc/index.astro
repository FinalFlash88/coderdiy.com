---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListing from '../../components/PostListing.astro';
import { useTranslations } from '../../i18n/ui';
import { getPostsByCategory } from '../../lib/posts';

const lang = 'vi' as const;
const t = useTranslations(lang);
const posts = await getPostsByCategory(lang, 'news');
---

<BaseLayout lang={lang} title={t('list.news.title')} description={t('list.news.subtitle')} altPath="/en/news/">
  <PostListing lang={lang} title={t('list.news.title')} subtitle={t('list.news.subtitle')} posts={posts} />
</BaseLayout>
