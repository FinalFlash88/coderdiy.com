---
import { routes, useTranslations, type Lang } from '../i18n/ui';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
  altPath?: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const otherLang: Lang = lang === 'vi' ? 'en' : 'vi';
const otherLangHref = altPath ?? routes[otherLang].home;

const nav = [
  { href: r.home, label: t('nav.home') },
  { href: r.news, label: t('nav.news') },
  { href: r.articles, label: t('nav.articles') },
  { href: r.forum, label: t('nav.forum') },
  { href: r.about, label: t('nav.about') },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === r.home ? path === href : path.startsWith(href));
---

<header class="sticky top-0 z-30 border-b border-border bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={r.home} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-accent text-accent-ink">&lt;/&gt;</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-accent text-accent-ink'
              : 'text-ink-soft hover:bg-bg-soft hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={otherLangHref}
        class="rounded-full border border-border px-3 py-1.5 text-sm font-medium text-ink-soft hover:text-ink"
        title={t('nav.language')}
      >
        {lang === 'vi' ? 'EN' : 'VI'}
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label={t('nav.theme')}
        title={t('nav.theme')}
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink-soft hover:text-ink"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-4 w-4">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav class="flex items-center gap-1 overflow-x-auto border-t border-border px-4 py-2 md:hidden">
    {nav.map((item) => (
      <a
        href={item.href}
        class:list={[
          'shrink-0 rounded-full px-3 py-1.5 text-sm font-medium',
          isActive(item.href) ? 'bg-accent text-accent-ink' : 'text-ink-soft',
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var sun = document.getElementById('icon-sun');
    var moon = document.getElementById('icon-moon');

    function sync() {
      var isDark = root.classList.contains('dark');
      if (sun && moon) {
        sun.classList.toggle('hidden', !isDark);
        moon.classList.toggle('hidden', isDark);
      }
    }
    sync();

    if (btn) {
      btn.addEventListener('click', function () {
        root.classList.toggle('dark');
        try {
          localStorage.setItem('coderdiy-theme', root.classList.contains('dark') ? 'dark' : 'light');
        } catch (_e) {}
        sync();
      });
    }
  })();
</script>
