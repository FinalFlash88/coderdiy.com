---
import PostCard from './PostCard.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Post } from '../lib/posts';

interface Props {
  lang: Lang;
  title: string;
  subtitle: string;
  posts: Post[];
}

const { lang, title, subtitle, posts } = Astro.props;
const t = useTranslations(lang);
const [first, ...rest] = posts;
---

<section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
  <h1 class="font-display text-3xl font-bold sm:text-4xl">{title}</h1>
  <p class="mt-2 max-w-2xl text-ink-soft">{subtitle}</p>

  {posts.length === 0 && <p class="mt-10 text-ink-soft">{t('list.empty')}</p>}

  {first && (
    <div class="mt-8">
      <PostCard post={first} lang={lang} featured />
    </div>
  )}

  {rest.length > 0 && (
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  )}
</section>
